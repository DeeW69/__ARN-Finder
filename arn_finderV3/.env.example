# Copier ce fichier en .env et renseigner vos valeurs

# NCBI — obligatoire
NCBI_EMAIL=votre.email@example.com
NCBI_TOOL=arnfinder_v3
# NCBI_API_KEY=votre_cle_api   # optionnel — débloque 10 req/s au lieu de 3

# BLAST — optionnel
BLAST_PROGRAM=blastn
BLAST_DB=nt
BLAST_MAX_HITS=10
BLAST_TIMEOUT=600

# Répertoire de données — optionnel (défaut: ./data)
# DATA_BASE=data
